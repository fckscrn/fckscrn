# Copy to .env.local (never commit it) and fill in. Without FAKTUROID_* everything is free, no watermark.
# ⚠️ With real Fakturoid credentials every order creates a REAL invoice — locally use tools/dev-billing-server.mjs.
PORT=8080
# DATA_DIR=./data
# EVENT_RETENTION_DAYS=14
# HOMEPAGE=app
# PUBLIC_URL=https://fckscrn.com
# GTM_ID=GTM-XXXXXXX      # Google Tag Manager on the product pages (with a cookie bar)
# SEARCH_INDEX=off        # test server: keep everything out of Google
# SOFFICE_JOBS=2          # PDF conversions at once (default: CPUs - 1, max 2)

FAKTUROID_ACCOUNT=
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
FAKTUROID_EMAIL=
FAKTUROID_WEBHOOK_TOKEN=
# PRICE_SINGLE=1490
# PRICE_MULTI=4990
