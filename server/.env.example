# Copy to .env.local (never commit it) and fill in. Without FAKTURACE_* everything is free, no watermark.
# ⚠️ Pointed at a real invoicing service every order creates a REAL proforma — locally use tools/dev-billing-server.mjs.
PORT=8080
# DATA_DIR=./data
# EVENT_RETENTION_DAYS=14
# HOMEPAGE=app
# PUBLIC_URL=https://fckscrn.com
# GTM_ID=GTM-XXXXXXX      # Google Tag Manager on the product pages (with a cookie bar)
# SEARCH_INDEX=off        # test server: keep everything out of Google
# SOFFICE_JOBS=2          # PDF conversions at once (default: CPUs - 1, max 2)

FAKTURACE_URL=
FAKTURACE_API_TOKEN=
# PRICE_SINGLE=1490
# PRICE_MULTI=4990
